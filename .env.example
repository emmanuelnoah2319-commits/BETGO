NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=betgo
SESSION_COOKIE_NAME=betgo_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Generate a random secret of at least 32 bytes for production.
SESSION_SECRET=replace-with-a-long-random-secret-before-production
# Bootstrap owner is created only when both values are supplied and no owner exists.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
# Bookmaker adapters remain disabled until authorized integration approval is verified.
BOOKMAKER_INTEGRATIONS_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Optional override for the unofficial, read-only SportyBet public web endpoint.
SPORTYBET_API_BASE_URL=https://www.sportybet.com

# Phase 1: transactional email and Flutterwave payment activation
RESEND_API_KEY=
# Must be a domain you have verified in Resend. onboarding@resend.dev only delivers to your own Resend account email;
# if you use it for testing, also set EMAIL_TESTING_RECIPIENT to that address.
EMAIL_FROM=BETGO <no-reply@your-verified-domain.com>
EMAIL_TESTING_RECIPIENT=
FLW_SECRET_KEY=
FLW_CALLBACK_URL=http://localhost:3000/payment/return
FLW_SECRET_HASH=
PRICE_SPORTYBET_NGN=5000
PRICE_FOOTBALL_COM_NGN=5000
PRICE_BETWINNER_NGN=6000
PRICE_SOKABET_NGN=5000
PRICE_MSPORT_NGN=6000


HECTOR_TIMEOUT_MS 20000
HECTOR_JOURNAL_DIR Empty
HECTOR_BIN hector
WAGER_EXECUTION_ENABLED false
